
from collections import Counter
from datetime import datetime

# Simulated web-server access logs
logs = [
    ("10:00:01", "192.0.2.10"),
    ("10:00:02", "192.0.2.10"),
    ("10:00:03", "192.0.2.10"),
    ("10:00:04", "192.0.2.10"),
    ("10:00:05", "192.0.2.10"),
    ("10:00:06", "192.0.2.20"),
    ("10:00:07", "192.0.2.20"),
    ("10:00:08", "192.0.2.30")
]

threshold = 4
request_counts = Counter(ip for timestamp, ip in logs)

print("=== DoS Detection from Web Logs ===")

for ip, count in sorted(request_counts.items()):
    print(f"IP: {ip}, Requests: {count}")

    if count >= threshold:
        print("ALERT: Possible DoS activity detected!")
    else:
        print("Status: Below request threshold")

print("\nAnalysis completed.")
